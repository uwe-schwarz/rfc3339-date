{
  "name": "rfc3339-date",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "build": "wrangler deploy --dry-run",
    "checks": "node scripts/update-openapi.mjs --check && pnpm run typecheck && pnpm run test && pnpm run build",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "docs:update": "node scripts/update-openapi.mjs",
    "docs:check": "node scripts/update-openapi.mjs --check && node scripts/scalar.mjs document validate public/openapi.json && node scripts/scalar.mjs document validate public/openapi.scalar.json && node scripts/scalar.mjs project check-config scalar.config.json",
    "scalar:publish": "pnpm run docs:check && node scripts/publish-scalar.mjs",
    "scalar:preview": "node scripts/scalar.mjs project preview scalar.config.json --no-open"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  },
  "config": {
    "scalarCliVersion": "2.11.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.10.0"
}
