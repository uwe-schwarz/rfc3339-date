{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rfc3339-date",
  "account_id": "3412b7b18e61869bba3dc055c8096f84",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-27",
  "routes": [{ "pattern": "rfc3339.date", "custom_domain": true }],
  "preview_urls": true,
  "observability": { "enabled": false },
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/imprint", "/index.html", "/imprint.html"],
  },
}
